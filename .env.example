# Copier ce fichier en .env et le compléter (le .env n'est jamais commité)
AURORACAST_CONTACT=ton.adresse@exemple.com
AURORACAST_RAW_DIR=data/raw

# Entrepôt PostgreSQL local (docker compose) : choisir un mot de passe, le même dans les 2 lignes
POSTGRES_PASSWORD=choisir-un-mot-de-passe
DATABASE_URL=postgresql://auroracast:choisir-un-mot-de-passe@localhost:5432/auroracast
